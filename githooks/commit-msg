#!/usr/bin/env bash
#
# Generated by Claude Opus 4.8 / Refined by @hdub-tech
# Run commitlinter before allowing commit message to persist

set -euo pipefail

LOGGER="[commit-msg hook]:"
REPO_ROOT="$(git rev-parse --show-toplevel)"
COMMITLINT_CONFIG="commitlint.config.mjs"
# Pinned for supply-chain safety and reproducibility.
COMMITLINT_VERSION="21.0.2"
LINT_RULES="${REPO_ROOT}/${COMMITLINT_CONFIG}"

commitlint() {
  echo "${LOGGER} Linting '$1' against '${LINT_RULES}'"

  if command -v podman >/dev/null || command -v docker >/dev/null ; then
    # use podman if available, else docker (both accept the same CLI surface)
    CONTAINER_RUNTIME="$(command -v podman || command -v docker)"
    "${CONTAINER_RUNTIME}" run -i --rm -v "${REPO_ROOT}":/workdir --entrypoint '' \
      docker.io/commitlint/commitlint:${COMMITLINT_VERSION} commitlint \
      --verbose --config /workdir/${COMMITLINT_CONFIG} < "$1"
  elif command -v npx >/dev/null ; then # if node based, use npx commitlint
    npx commitlint --verbose --config "${LINT_RULES}" < "$1"
  else
    echo >&2 "${LOGGER} No commitlint runtime available. Install one of: podman, docker, npx"
    exit 1
  fi
}

if [ -e "${LINT_RULES}" ]; then
  commitlint "$1" || {
    echo >&2 "${LOGGER} ${LINT_RULES} violation. See output above to debug"
    exit 1
  }
else
  echo "${LOGGER} Config ${LINT_RULES} doesn't exist... skipping commitlint"
  exit 1
fi
