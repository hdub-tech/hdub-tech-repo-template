#!/usr/bin/env bash
#
# Generated by Claude Sonnet 4.6 / Refined by @hdub-tech
# Fixes worktree gitdir path to a relative reference and links .claude.
# Git passes: $1=prev-HEAD, $2=new-HEAD, $3=checkout-type (1=branch, 0=file).

set -euo pipefail

LOGGER="[post-checkout]:"
PREV_HEAD="${1:-}"

# Fail fast if GNU realpath isn't available so users get a clear message
# instead of confusing option-parsing errors deeper in the script.
if ! realpath --relative-to=. . >/dev/null 2>&1; then
    echo >&2 "${LOGGER} ERROR: GNU realpath required (needs --relative-to and --no-symlinks)."
    echo >&2 "${LOGGER}        On macOS/BSD: 'brew install coreutils' and ensure GNU realpath is on PATH."
    exit 1
fi

# Resolve a (possibly relative) path to its absolute directory path
abs_dir() { (cd "$1" || exit 1; pwd); }

# Relative path from directory $1 to path $2, following symlinks
rel_path() { realpath --relative-to="$1" "$2"; }

# Relative path from directory $1 to path $2, NOT following symlinks in $2
rel_path_no_follow() { realpath --no-symlinks --relative-to="$1" "$2"; }

# ── Resolve key paths ─────────────────────────────────────────────────────────
WORKTREE_DIR=$(abs_dir "$(git rev-parse --show-toplevel)")
GIT_COMMON_DIR=$(abs_dir "$(git rev-parse --git-common-dir)")
GIT_DIR_ABS=$(abs_dir "$(git rev-parse --git-dir)")
MAIN_REPO_ROOT=$(dirname "$GIT_COMMON_DIR")

# ── Detect main worktree ──────────────────────────────────────────────────────
if [ "$GIT_DIR_ABS" = "$GIT_COMMON_DIR" ]; then
    echo "${LOGGER} In main worktree — skipping worktree-specific fixups."
    exit 0
fi

# ── Detect new worktree checkout ──────────────────────────────────────────────
# If PREV_HEAD is all zeroes, this is new (gaurds for sha-1 and sha-256 hashes)
if [[ ! "$PREV_HEAD" =~ ^0+$ ]]; then
    echo "${LOGGER} Not a new worktree checkout — skipping."
    exit 0
fi

# ── Output key paths ──────────────────────────────────────────────────────────
echo "${LOGGER} Worktree dir:             $WORKTREE_DIR"
echo "${LOGGER} Main repo root:           $MAIN_REPO_ROOT"
echo "${LOGGER} Git common dir:           $GIT_COMMON_DIR"
echo "${LOGGER} Git dir (this worktree):  $GIT_DIR_ABS"

# ── Fix <worktree>/.git ──────────────────────────────────────────────────────
WORKTREE_GIT_FILE="$WORKTREE_DIR/.git"
echo -e "\n${LOGGER} Check/fix $WORKTREE_GIT_FILE"

if [ ! -f "$WORKTREE_GIT_FILE" ]; then
    echo "${LOGGER}   ERROR: $WORKTREE_GIT_FILE is not a regular file — unexpected state." >&2
    exit 1
fi

CURRENT_CONTENT=$(<"${WORKTREE_GIT_FILE}")
GITDIR_PREFIX="gitdir: "
if [[ "${CURRENT_CONTENT}" != "${GITDIR_PREFIX}"* ]]; then
    echo >&2 "${LOGGER}   ERROR: ${WORKTREE_GIT_FILE} is malformed (missing '${GITDIR_PREFIX}' prefix)"
    echo >&2 "${LOGGER}   Contents: ${CURRENT_CONTENT}"
    exit 1
fi

if [[ "${CURRENT_CONTENT}" == "${GITDIR_PREFIX}.."* ]]; then
    echo "${LOGGER}   Already relative (${CURRENT_CONTENT}) — no change needed."
else
    REL_PATH=$(rel_path "${WORKTREE_DIR}" "${GIT_DIR_ABS}")
    NEW_CONTENT="${GITDIR_PREFIX}${REL_PATH}"
    echo "${LOGGER}   Updating:"
    echo "${LOGGER}     was: ${CURRENT_CONTENT}"
    echo "${LOGGER}     now: ${NEW_CONTENT}"
    # Atomic replace: write to same-directory temp file, then rename.
    TMP_FILE=$(mktemp "${WORKTREE_GIT_FILE}.XXXXXX")
    trap 'rm -f "${TMP_FILE}"' EXIT
    printf '%s\n' "${NEW_CONTENT}" > "${TMP_FILE}"
    mv "${TMP_FILE}" "${WORKTREE_GIT_FILE}"
    trap - EXIT
    echo "${LOGGER}   Done."
fi

# ── .claude symlink ───────────────────────────────────────────────────────────
CLAUDE_DIR_NAME=".claude"
MAIN_CLAUDE="$MAIN_REPO_ROOT/$CLAUDE_DIR_NAME"
WORKTREE_CLAUDE="$WORKTREE_DIR/$CLAUDE_DIR_NAME"
echo -e "\n${LOGGER} Check/create $WORKTREE_CLAUDE"

if [ ! -e "$MAIN_CLAUDE" ] && [ ! -L "$MAIN_CLAUDE" ]; then
    echo "${LOGGER}   SKIP: $MAIN_CLAUDE does not exist — nothing to link."
elif [ -L "$WORKTREE_CLAUDE" ]; then
    EXISTING_TARGET=$(readlink "$WORKTREE_CLAUDE")
    echo "${LOGGER}   Already a symlink ($WORKTREE_CLAUDE -> $EXISTING_TARGET) — no change needed."
elif [ -e "$WORKTREE_CLAUDE" ]; then
    echo "${LOGGER}   WARN: $WORKTREE_CLAUDE exists but is not a symlink — leaving it alone."
else
    echo "${LOGGER}   Source: $MAIN_CLAUDE"
    # --no-symlinks: link TO .claude (preserve its indirection), not through it
    REL_PATH=$(rel_path_no_follow "$WORKTREE_DIR" "$MAIN_CLAUDE")
    echo "${LOGGER}   Creating symlink:"
    echo "${LOGGER}     $WORKTREE_CLAUDE -> $REL_PATH"
    ln -s "$REL_PATH" "$WORKTREE_CLAUDE"
    echo "${LOGGER}   Done."
fi

echo -e "\n${LOGGER} All steps complete."
